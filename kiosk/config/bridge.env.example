# KidZonics RFID bridge settings. Installed to /etc/kidzonics/bridge.env
# (readable by root only, because it holds the kiosk token).

# Your Base44 app id: the part after /apps/ in the Builder URL
# (app.base44.com/apps/<APP_ID>/...).
BASE44_APP_ID=

# Shared secret. It must equal the KIOSK_BRIDGE_TOKEN secret you set in the
# Base44 dashboard (Settings > Secrets). install.sh generates one for you.
KIOSK_BRIDGE_TOKEN=

# Which input device is the RFID reader. Run this and tap a card to find it:
#   sudo /opt/kidzonics/bridge/kidzonics_bridge.py --detect
# If left empty and only one keyboard-like device is plugged in, it is used.
READER_DEVICE=
# Alternative: part of the reader's name as shown by --list.
READER_NAME=

# Name shown in the app's tap log. Defaults to the Pi's hostname.
KIOSK_DEVICE_NAME=

# How often to tell the app the reader is online. The app treats the reader
# as offline after 90 seconds without one, so keep this well below 90.
HEARTBEAT_SECONDS=30

# Only needed if Base44 gives you a different function URL.
# BRIDGE_URL=https://base44.app/api/apps/<APP_ID>/functions/rfidBridge
