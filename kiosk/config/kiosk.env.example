# KidZonics kiosk screen settings. Installed to /etc/kidzonics/kiosk.env

# Your published app address, e.g. https://kidzonics.base44.app
KIOSK_URL=

# Start page on the kiosk. /identify goes straight to "Who are you?".
KIOSK_START_PATH=/

# After this many seconds without a touch, the kiosk asks "Are you still
# there?" and then returns to the start page, signing out the student (and a
# teacher, if one signed in on the kiosk). 0 turns this off.
KIOSK_IDLE_SECONDS=180

# yes = the browser may only open the app and the Base44/Google sign-in pages.
# Test every screen (lessons, videos, teacher sign-in) after turning it on.
KIOSK_LOCK_URLS=no
